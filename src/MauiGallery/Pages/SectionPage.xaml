<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiGallery.Models"
             x:Class="MauiGallery.Pages.SectionPage"
             Title="分类">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="{Binding Title}" Style="{StaticResource GalleryTitleLabel}" />
            <Label Text="{Binding Description}" />
        </VerticalStackLayout>

        <SearchBar Grid.Row="1"
                   x:Name="FilterSearchBar"
                   Placeholder="在此分类中筛选 / Filter this category"
                   TextChanged="OnFilterChanged" />

        <CollectionView Grid.Row="2"
                        x:Name="ItemsCollection"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ControlInfoDataItem">
                    <Border Style="{StaticResource CardBorder}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding BadgeText}"
                                           IsVisible="{Binding HasBadge}"
                                           FontSize="10"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#512BD4, Dark=#DFD8F7}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Subtitle}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
