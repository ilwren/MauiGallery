<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiGallery.Models"
             x:Class="MauiGallery.Pages.HomePage"
             x:Name="Root"
             Title="主页">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="8">

            <Label Text="MAUI Gallery" Style="{StaticResource GalleryTitleLabel}" />
            <Label Text="完整展示 .NET MAUI（Microsoft.Maui.Controls）内置的全部控件、布局、样式与交互能力。示例结构参考 WinUI 3 Gallery，控件清单与 API 依据 dotnet/maui 官方源码整理。"
                   Style="{StaticResource GallerySubtitleLabel}" />

            <!-- Hero -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label Grid.Row="0" Text="从这里开始" FontFamily="OpenSansSemibold" FontSize="20" />
                    <Label Grid.Row="1" Text="按分类浏览 60+ 控件页面，每页包含可交互示例与对应 XAML / C# 源码。" />
                    <Button Grid.Row="2" Text="浏览所有控件 / Browse all controls"
                            Clicked="OnBrowseAllClicked"
                            HorizontalOptions="Start" />
                </Grid>
            </Border>

            <Label Text="控件分类 / Categories" Style="{StaticResource SectionHeaderLabel}" />

            <!-- Category cards -->
            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding .}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ControlInfoDataGroup">
                        <Border Style="{StaticResource CardBorder}"
                                Margin="0,0,12,12"
                                WidthRequest="260"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="17" />
                                <Label Text="{Binding Subtitle}" FontSize="12" />
                                <Label Text="{Binding Description}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
