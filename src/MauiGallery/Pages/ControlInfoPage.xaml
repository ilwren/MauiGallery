<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             xmlns:models="clr-namespace:MauiGallery.Models"
             x:Class="MauiGallery.Pages.ControlInfoPage"
             x:DataType="models:ControlInfoDataItem"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="4">

            <!-- Title / description / API / docs -->
            <controls:PageHeader />

            <!-- Live samples for the control -->
            <ContentView x:Name="SampleHost" Margin="0,8,0,24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
