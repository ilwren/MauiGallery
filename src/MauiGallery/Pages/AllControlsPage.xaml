<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiGallery.Models"
             x:Class="MauiGallery.Pages.AllControlsPage"
             Title="所有控件">

    <Grid RowDefinitions="Auto,*" Padding="16,8">
        <Label Grid.Row="0"
               Text="所有控件 / All controls"
               Style="{StaticResource SectionHeaderLabel}" />

        <CollectionView Grid.Row="1"
                        x:Name="ControlsCollection"
                        IsGrouped="True"
                        SelectionMode="None">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:ItemGroup">
                    <Label Text="{Binding Title}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           BackgroundColor="{AppThemeBinding Light=#EEE6FF, Dark=#3B2A6B}"
                           TextColor="{AppThemeBinding Light=#512BD4, Dark=#DFD8F7}"
                           Padding="12,8" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ControlInfoDataItem">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding BadgeText}"
                                           IsVisible="{Binding HasBadge}"
                                           FontSize="10"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#512BD4, Dark=#DFD8F7}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Subtitle}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
