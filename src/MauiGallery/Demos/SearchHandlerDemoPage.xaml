<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             x:Class="MauiGallery.Demos.SearchHandlerDemoPage"
             Title="SearchHandler">

    <Shell.SearchHandler>
        <SearchHandler x:Name="Handler"
                       Placeholder="搜索水果 / Search fruits"
                       ShowsResults="True"
                       Query="{Binding Query, Mode=TwoWay}"
                       QueryIcon="dotnet_bot.png"
                       Command="{Binding SearchCommand}" />
    </Shell.SearchHandler>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="SearchHandler / 搜索框" FontSize="24" FontAttributes="Bold" />
            <Label Text="SearchHandler 挂在 Shell.SearchHandler 上，占据导航栏搜索区。ShowsResults=True 时输入即展示建议列表；QueryIcon/Placeholder/Command 等可自定义。"
                   FontSize="14" />
            <Label x:Name="ResultLabel" Text="在上方搜索框输入内容…" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
