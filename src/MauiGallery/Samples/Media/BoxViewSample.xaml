<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             x:Class="MauiGallery.Samples.Media.BoxViewSample">

    <ContentView.Resources>
        <x:String x:Key="BoxBasicXaml">&lt;BoxView Color="Purple" WidthRequest="100" HeightRequest="100" /&gt;</x:String>
        <x:String x:Key="BoxCornerXaml">&lt;BoxView Color="Teal" CornerRadius="12" /&gt;</x:String>
        <x:String x:Key="BoxDividerXaml">&lt;!-- 分隔线 --&gt;
&lt;BoxView HeightRequest="1" Color="Gray" /&gt;</x:String>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="4,0" Spacing="4">

            <controls:ControlExample Title="基本色块 / Basic BoxView"
                                     Description="BoxView 绘制纯色矩形（Color），尺寸由布局决定或用 WidthRequest/HeightRequest 固定。"
                                     Xaml="{StaticResource BoxBasicXaml}">
                <controls:ControlExample.Example>
                    <HorizontalStackLayout Spacing="12">
                        <BoxView Color="#512BD4" WidthRequest="90" HeightRequest="90" />
                        <BoxView Color="#D600AA" WidthRequest="90" HeightRequest="90" />
                        <BoxView Color="#2B0B98" WidthRequest="90" HeightRequest="90" />
                    </HorizontalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="圆角 / CornerRadius"
                                     Description="CornerRadius 使四角圆滑；配合 Opacity 与 Shadow 可当占位卡片。"
                                     Xaml="{StaticResource BoxCornerXaml}">
                <controls:ControlExample.Example>
                    <HorizontalStackLayout Spacing="12">
                        <BoxView Color="#2B0B98" WidthRequest="90" HeightRequest="90" CornerRadius="12" />
                        <BoxView Color="#9880e5" WidthRequest="90" HeightRequest="90" CornerRadius="45" />
                    </HorizontalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="分隔线 / Divider"
                                     Description="高度为 1 的 BoxView 是最轻量的分隔线（也可用 Border）。"
                                     Xaml="{StaticResource BoxDividerXaml}">
                <controls:ControlExample.Example>
                    <VerticalStackLayout>
                        <Label Text="上面的内容 / Above" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#C8C8C8, Dark=#404040}" Margin="0,8" />
                        <Label Text="下面的内容 / Below" />
                    </VerticalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
