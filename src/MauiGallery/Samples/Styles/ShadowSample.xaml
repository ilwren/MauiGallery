<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             x:Class="MauiGallery.Samples.Styles.ShadowSample">

    <ContentView.Resources>
        <x:String x:Key="ShadowXaml">&lt;Border Shadow="{Shadow Brush=Black, Opacity=0.3, Offset=0,6, Radius=12}" /&gt;
&lt;!-- 或属性元素 --&gt;
&lt;Border.Shadow&gt;
    &lt;Shadow Brush="Black" Opacity="0.3" Offset="0,6" Radius="12" /&gt;
&lt;/Border.Shadow&gt;</x:String>
        <x:String x:Key="ClipXaml">&lt;Image Clip="{EllipseGeometry Center=50,50 RadiusX=50 RadiusY=50}" /&gt;
&lt;!-- Clip 用 Geometry 裁剪内容 --&gt;</x:String>
        <x:String x:Key="TransformXaml">&lt;BoxView Rotation="30" Scale="1.2"
        TranslationX="10" TranslationY="-5"
        AnchorX="0.5" AnchorY="0.5" /&gt;
&lt;!-- RotateTo/ScaleTo/TranslateTo 动画扩展 --&gt;</x:String>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="4,0" Spacing="4">

            <controls:ControlExample Title="Shadow / 阴影"
                                     Description="Shadow（Brush、Opacity、Offset、Radius）为任意视图添加投影；常与 Border/圆角组合成卡片。"
                                     Xaml="{StaticResource ShadowXaml}">
                <controls:ControlExample.Example>
                    <FlexLayout Wrap="Wrap">
                        <Border Padding="20" Margin="0,0,16,16" BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.3" Offset="0,6" Radius="12" />
                            </Border.Shadow>
                            <Label Text="标准阴影 / Soft" TextColor="#242424" />
                        </Border>
                        <Border Padding="20" Margin="0,0,16,16" BackgroundColor="#512BD4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#512BD4" Opacity="0.5" Offset="0,10" Radius="20" />
                            </Border.Shadow>
                            <Label Text="彩色阴影 / Colored" TextColor="White" />
                        </Border>
                    </FlexLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="Clip / 裁剪"
                                     Description="Clip 属性用 Geometry（EllipseGeometry、RectangleGeometry、RoundRectangleGeometry…）裁剪视图内容。"
                                     Xaml="{StaticResource ClipXaml}">
                <controls:ControlExample.Example>
                    <HorizontalStackLayout Spacing="16">
                        <Border WidthRequest="100" HeightRequest="100" Padding="0" BackgroundColor="#EEE6FF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0" />
                            </Border.StrokeShape>
                            <Border.Clip>
                                <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                            </Border.Clip>
                            <Label Text="圆形裁剪" VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        <Border WidthRequest="100" HeightRequest="100" Padding="0" BackgroundColor="#FCE4EC">
                            <Border.Clip>
                                <RoundRectangleGeometry Rect="0,0,100,100" CornerRadius="20,0,20,0" />
                            </Border.Clip>
                            <Label Text="圆角裁剪" VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="Transform / 变换"
                                     Description="Rotation、Scale、TranslationX/Y、AnchorX/Y 属性直接变换视图；RotateTo/ScaleTo/TranslateTo 提供动画（见 Gestures 页）。"
                                     Xaml="{StaticResource TransformXaml}">
                <controls:ControlExample.Example>
                    <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <BoxView Color="#512BD4" WidthRequest="70" HeightRequest="70" CornerRadius="8"
                                 Rotation="15" Margin="0,0,16,16" />
                        <BoxView Color="#D600AA" WidthRequest="70" HeightRequest="70" CornerRadius="8"
                                 Scale="1.2" Margin="0,0,16,16" />
                        <BoxView Color="#2B0B98" WidthRequest="70" HeightRequest="70" CornerRadius="8"
                                 TranslationX="10" TranslationY="-10" Rotation="-10" Margin="0,0,16,16" />
                    </FlexLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
