<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             x:Class="MauiGallery.Samples.Layouts.BorderSample">

    <ContentView.Resources>
        <x:String x:Key="BorderBasicXaml">&lt;Border Stroke="Purple"
        StrokeThickness="2"
        Padding="12"&gt;
    &lt;Label Text="带边框的内容 / Bordered content" /&gt;
&lt;/Border&gt;</x:String>
        <x:String x:Key="BorderShapeXaml">&lt;Border.StrokeShape&gt;
    &lt;RoundRectangle CornerRadius="16" /&gt;
&lt;/Border.StrokeShape&gt;
&lt;!-- StrokeShape 也接受 Path 几何 --&gt;</x:String>
        <x:String x:Key="BorderDashXaml">&lt;Border Stroke="Teal"
        StrokeDashArray="4,2"
        StrokeLineJoin="Round"
        StrokeLineCap="Round" /&gt;</x:String>
        <x:String x:Key="BorderShadowXaml">&lt;Border Shadow="{Shadow ...}" /&gt;
&lt;!-- 或 &lt;Border.Shadow&gt;&lt;Shadow ... /&gt;&lt;/Border.Shadow&gt; --&gt;</x:String>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="4,0" Spacing="4">

            <controls:ControlExample Title="基础边框 / Basic Border"
                                     Description="Border 是 MAUI 推荐的内容边框容器：Stroke（画刷）、StrokeThickness、Padding、BackgroundColor。"
                                     Xaml="{StaticResource BorderBasicXaml}">
                <controls:ControlExample.Example>
                    <Border Stroke="#512BD4" StrokeThickness="2" Padding="16">
                        <Label Text="带边框的内容 / Bordered content" />
                    </Border>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="形状 / StrokeShape"
                                     Description="StrokeShape 指定描边轮廓：RoundRectangle（CornerRadius）最常用，也可用 Rectangle 或自定义 Path。"
                                     Xaml="{StaticResource BorderShapeXaml}">
                <controls:ControlExample.Example>
                    <HorizontalStackLayout Spacing="12">
                        <Border Stroke="#512BD4" StrokeThickness="2" Padding="16">
                            <Border.StrokeShape>
                                <Rectangle />
                            </Border.StrokeShape>
                            <Label Text="直角 / Rectangle" VerticalOptions="Center" />
                        </Border>
                        <Border Stroke="#D600AA" StrokeThickness="2" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label Text="圆角 / Rounded" VerticalOptions="Center" />
                        </Border>
                        <Border Stroke="#2B0B98" StrokeThickness="2" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30" />
                            </Border.StrokeShape>
                            <Label Text="胶囊 / Pill" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="虚线描边 / Dashed stroke"
                                     Description="StrokeDashArray（DoubleCollection）定义虚线节奏；StrokeDashOffset 偏移；StrokeLineJoin/StrokeLineCap 控制转角与端点。"
                                     Xaml="{StaticResource BorderDashXaml}">
                <controls:ControlExample.Example>
                    <VerticalStackLayout Spacing="10">
                        <Border Stroke="Teal" StrokeThickness="2" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.StrokeDashArray>
                                <DoubleCollection>
                                    <x:Double>4</x:Double>
                                    <x:Double>2</x:Double>
                                </DoubleCollection>
                            </Border.StrokeDashArray>
                            <Label Text="虚线边框 / Dashed border" />
                        </Border>
                        <Border Stroke="#D600AA" StrokeThickness="3" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.StrokeDashArray>
                                <DoubleCollection>
                                    <x:Double>8</x:Double>
                                    <x:Double>4</x:Double>
                                </DoubleCollection>
                            </Border.StrokeDashArray>
                            <Label Text="粗虚线 / Thick dashes" />
                        </Border>
                    </VerticalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="阴影卡片 / Shadow card"
                                     Description="Shadow（Offset/Radius/Brush/Opacity）为 Border 添加投影，是卡片布局的常用组合。"
                                     Xaml="{StaticResource BorderShadowXaml}">
                <controls:ControlExample.Example>
                    <Border Padding="20" Margin="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.25" Offset="0,6" Radius="12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="阴影卡片 / Shadow card" FontFamily="OpenSansSemibold" FontSize="17" />
                            <Label Text="Shadow + RoundRectangle 组合" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </controls:ControlExample.Example>
            </controls:ControlExample>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
