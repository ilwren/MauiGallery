<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             x:Class="MauiGallery.Samples.Layouts.FrameSample">

    <ContentView.Resources>
        <x:String x:Key="FrameBasicXaml">&lt;Frame BorderColor="Gray"
       CornerRadius="10"
       Padding="12"
       HasShadow="True"&gt;
    &lt;Label Text="Frame 内容 / Content" /&gt;
&lt;/Frame&gt;</x:String>
        <x:String x:Key="FrameCompatXaml">&lt;!-- 官方建议：新代码用 Border 代替 Frame --&gt;
&lt;Border Stroke="Gray" Padding="12"&gt;
    &lt;Border.StrokeShape&gt;
        &lt;RoundRectangle CornerRadius="10" /&gt;
    &lt;/Border.StrokeShape&gt;
    &lt;Label Text="Border 内容 / Content" /&gt;
&lt;/Border&gt;</x:String>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="4,0" Spacing="4">

            <controls:ControlExample Title="Frame（遗留）/ Legacy Frame"
                                     Description="Frame 提供 BorderColor、CornerRadius、Padding、HasShadow。标记为兼容保留，新代码建议使用 Border。"
                                     Xaml="{StaticResource FrameBasicXaml}">
                <controls:ControlExample.Example>
                    <VerticalStackLayout Spacing="10">
                        <Frame BorderColor="#512BD4" CornerRadius="10" Padding="16" HasShadow="True">
                            <Label Text="带阴影的 Frame / Frame with shadow" />
                        </Frame>
                        <Frame BorderColor="#D600AA" CornerRadius="20" Padding="16" HasShadow="False" BackgroundColor="#FCE4EC">
                            <Label Text="圆角彩色 Frame / Rounded colored frame" />
                        </Frame>
                    </VerticalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="Border 替代方案 / Border equivalent"
                                     Description="同样的视觉效果可以用 Border + RoundRectangle + Shadow 表达，且支持更多描边定制。"
                                     Xaml="{StaticResource FrameCompatXaml}">
                <controls:ControlExample.Example>
                    <Border Stroke="#512BD4" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.2" Offset="0,4" Radius="8" />
                        </Border.Shadow>
                        <Label Text="Border 内容 / Border content" />
                    </Border>
                </controls:ControlExample.Example>
            </controls:ControlExample>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
