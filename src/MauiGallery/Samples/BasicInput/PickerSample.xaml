<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiGallery.Controls"
             x:Class="MauiGallery.Samples.BasicInput.PickerSample">

    <ContentView.Resources>
        <x:String x:Key="PickerBasicXaml">&lt;Picker Title="选择水果 / Pick a fruit"
        ItemsSource="{Binding Fruits}"
        SelectedIndex="0" /&gt;</x:String>
        <x:String x:Key="PickerEventXaml">&lt;Picker SelectedIndexChanged="OnSelectedIndexChanged" /&gt;</x:String>
        <x:String x:Key="PickerStyleXaml">&lt;Picker Title="标题颜色 / Title"
        TitleColor="Gray"
        TextColor="DarkBlue"
        FontSize="16" /&gt;</x:String>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="4,0" Spacing="4">

            <controls:ControlExample Title="基础选择器 / Basic Picker"
                                     Description="ItemsSource 提供选项（也支持直接写 Items 集合）。Title 是未选择时的提示；SelectedIndex/SelectedItem 表示当前选择。"
                                     Xaml="{StaticResource PickerBasicXaml}">
                <controls:ControlExample.Example>
                    <VerticalStackLayout Spacing="8">
                        <Picker x:Name="FruitPicker"
                                Title="选择水果 / Pick a fruit"
                                SelectedIndexChanged="OnSelectedIndexChanged" />
                        <Label x:Name="PickerOutput" Text="尚未选择" />
                    </VerticalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="事件 / Events"
                                     Description="SelectedIndexChanged 在选择变化时触发，可读取 SelectedItem 与 SelectedIndex。"
                                     Xaml="{StaticResource PickerEventXaml}">
                <controls:ControlExample.Example>
                    <VerticalStackLayout Spacing="8">
                        <Picker x:Name="CountryPicker"
                                Title="选择国家 / Country"
                                SelectedIndexChanged="OnCountryChanged" />
                        <Label x:Name="CountryOutput" Text="—" />
                    </VerticalStackLayout>
                </controls:ControlExample.Example>
            </controls:ControlExample>

            <controls:ControlExample Title="外观 / Appearance"
                                     Description="TitleColor、TextColor、FontSize、FontFamily 等外观属性同样适用。"
                                     Xaml="{StaticResource PickerStyleXaml}">
                <controls:ControlExample.Example>
                    <Picker x:Name="StylePicker"
                            Title="标题颜色 / Title"
                            TitleColor="Gray"
                            TextColor="DarkBlue"
                            FontSize="16" />
                </controls:ControlExample.Example>
            </controls:ControlExample>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
